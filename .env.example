# Telegram bot tokenlari (@BotFather orqali oling)
SHOP_BOT_TOKEN=
EXAM_BOT_TOKEN=

# Claude API kaliti. Bo'sh qoldirsangiz bot "demo rejim"da (mock AI) ishlaydi.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Katalog sayti jamoat manzili (bot havola yasashda ishlatadi)
PUBLIC_URL=http://localhost:3000

# SQLite fayl yo'li
DATABASE_PATH=data/shop.db
EXAM_DATABASE_PATH=data/exam.db
